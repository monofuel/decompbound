# LLM plays EarthBound (qwen on azem): windowed --speed 60 --watch-async.
# Start: bin/states/llm/bedroom.state ONLY (never make-play slot1–4). Seeds from game_start if missing.
# Ctrl+C quit. Sync: ARGS="--sync-llm". Fixture: ARGS="--load-state-path bin/states/llm/foo.state".
llm-ai: nim.cfg
	@mkdir -p bin bin/states/llm
	@if [ ! -f bin/states/llm/bedroom.state ] && [ -f bin/states/game_start.state ]; then \
	  cp bin/states/game_start.state bin/states/llm/bedroom.state; \
	  echo "seeded bin/states/llm/bedroom.state from game_start.state"; \
	fi
	nim r src/tools/llm_ai.nim -- --no-mock --load-state-path bin/states/llm/bedroom.state --speed 60 --watch-async --frames 20000 $(ARGS) "$(ROM)"

# Gold opening TAS (bedroom → sunrise) then the bot takes the pad.
PROLOGUE_TAS ?= ../decompbound_secret/sessions/20260816-223148/20260816-223148.tas
llm-ai-prologue: nim.cfg $(LUA_LIB)
	@mkdir -p bin bin/states/llm
	@test -f "$(or $(TAS),$(PROLOGUE_TAS))" || (echo "missing TAS=$(or $(TAS),$(PROLOGUE_TAS))"; exit 2)
	@echo "llm-ai-prologue: TAS prefix $(or $(TAS),$(PROLOGUE_TAS)) then agent"
	nim r src/tools/llm_ai.nim -- --no-mock --tas "$(or $(TAS),$(PROLOGUE_TAS))" --speed 60 --watch-async --frames 20000 $(ARGS) "$(ROM)"

# Deterministic seed Lua (no qwen). Same Agent* policies product tests exercise.
# Prologue only from bedroom — stalls at bed/sleep (knock soft 80) without campaign seats.
# Watch overnight product work past knock: make llm-ai-scripted-campaign
llm-ai-scripted: nim.cfg
	@mkdir -p bin bin/states/llm
	@if [ ! -f bin/states/llm/bedroom.state ] && [ -f bin/states/game_start.state ]; then \
	  cp bin/states/game_start.state bin/states/llm/bedroom.state; \
	  echo "seeded bin/states/llm/bedroom.state from game_start.state"; \
	fi
	@echo "llm-ai-scripted: --mock (deterministic seeds, no qwen). Ctrl+C quit."
	nim r src/tools/llm_ai.nim -- --mock --pilot scripted --tempo theater \
	  --load-state-path bin/states/llm/bedroom.state --speed 60 --watch-async \
	  --frames 20000 $(ARGS) "$(ROM)"

# Same as llm-ai-scripted but --campaign-fixtures (seat jumps over sleep + later walls).
# This is the windowed view of the product soft spine (leave / fo / soft98 handoffs).
llm-ai-scripted-campaign: nim.cfg
	@mkdir -p bin bin/states/llm
	@if [ ! -f bin/states/llm/bedroom.state ] && [ -f bin/states/game_start.state ]; then \
	  cp bin/states/game_start.state bin/states/llm/bedroom.state; \
	  echo "seeded bin/states/llm/bedroom.state from game_start.state"; \
	fi
	@echo "llm-ai-scripted-campaign: --mock + campaign seats (no qwen). Ctrl+C quit."
	nim r src/tools/llm_ai.nim -- --mock --pilot scripted --tempo theater \
	  --campaign-fixtures --load-state-path bin/states/llm/bedroom.state \
	  --speed 60 --watch-async --frames 999999 $(ARGS) "$(ROM)"

# Always-on house-display: same as llm-ai but huge frame cap. LLM state namespace only.
# Prefer `make llm-ai-display-loop` for crash-restart + logging.
llm-ai-display: nim.cfg
	@mkdir -p bin bin/states/llm
	@if [ ! -f bin/states/llm/bedroom.state ] && [ -f bin/states/game_start.state ]; then \
	  cp bin/states/game_start.state bin/states/llm/bedroom.state; \
	  echo "seeded bin/states/llm/bedroom.state from game_start.state"; \
	fi
	nim r src/tools/llm_ai.nim -- --no-mock --load-state-path bin/states/llm/bedroom.state --speed 60 --watch-async --frames 999999 $(ARGS) "$(ROM)"

# Forever restart wrapper: logs bin/llm_display.log, prints last tg max between restarts.
# Dry-run: make llm-ai-display-loop DRY_RUN=1
# Env: SLEEP_SECS, LOG, ARGS, DRY_RUN (see scripts/llm_display_loop.sh).
llm-ai-display-loop:
	@mkdir -p bin
	DRY_RUN="$(DRY_RUN)" SLEEP_SECS="$(SLEEP_SECS)" LOG="$(LOG)" ARGS="$(ARGS)" ./scripts/llm_display_loop.sh

# Run a SNES test ROM through the accuracy harness (PASS/FAIL/UNKNOWN + a frame
# dump). e.g. make testrom ROM=bin/testroms/blargg/test_speed.smc FRAMES=400
testrom: nim.cfg
	nim r src/tools/testrom.nim -- "$(ROM)" $(FRAMES)

# Decode + dump a dialogue block from the ROM to stdout (never committed).
# e.g. make script-dump OFF=0x63040
script-dump: nim.cfg
	nim r src/tools/script_dump.nim "$(ROM)" $(OFF)

# Verify the graphics compression codec round-trips byte-exact against the ROM.
gfx-roundtrip: nim.cfg
	nim r src/tools/gfx_roundtrip.nim "$(ROM)"

# Render animated battle background frames (headless). BG and FRAMES have defaults.
#   make battle-bg
#   make battle-bg BG=6 FRAMES=30
battle-bg: nim.cfg
	nim r src/tools/battle_bg_explore.nim --bg $(BG) --frames $(FRAMES)

# Trace emulator state changes to bin/trace.log — the decomp instrument. Pass
# options via ARGS, e.g. make trace ARGS="--frames 240 --watch 0x0020-0x0120"
# (add --load-srm to boot your .srm and reach a real game state).
trace: nim.cfg
	@mkdir -p bin
	nim r src/tools/trace_tool.nim -- $(ARGS) "$(ROM)"

# Inspect a save-state slot: dump PPU/HDMA config + the HDMA table + per-line TM/TS
# bands, and render it to bin/state_inspect.png. Diagnoses battle/render bugs from a
# Ctrl+1 save-state. e.g. make inspect SLOT=1
inspect: nim.cfg
	@mkdir -p bin
	nim r src/tools/state_inspect.nim -- "$(ROM)" $(SLOT) bin/state_inspect.png

# Audio regression gate for S-DSP (silence/halving). Headless collect + peak/RMS
# assert + WAV capture. Run on title/intro or --load-state for specific SFX.
audio-check: nim.cfg
	@mkdir -p bin
	nim r src/tools/audio_check.nim --frames 1400 "$(ROM)"


# Three tiers, selected by filename prefix (scriptorium convention):
#   tests/test_*.nim         unit — no ROM, no save-state, no vectors. Instant.
#                            The only tier CI can run: every fixture is
#                            gitignored for copyright hygiene.
#   tests/integration_*.nim  needs the gold ROM or the SingleStepTests vector
#                            repos. Local only, seconds.
#   tests/e2e_*.nim          boots the emulator, restores a save-state, and
#                            runs the LLM-play policy for thousands of frames.
#                            Local only, minutes per test.
#
# Cap parallel test compiles so unbounded fan-out does not swamp the box.
# Output is captured per test so a nim failure is not masked by the sed pipe.
NIM_TEST_JOBS ?= 4

RUN_TESTS = xargs -P $(NIM_TEST_JOBS) -I{} sh -c \
	'out=$$(nim r $(NIM_TEST_FLAGS) "{}" 2>&1); rc=$$?; \
	 printf "%s\n" "$$out" | sed "s|^|[{}] |"; exit $$rc'

test: nim.cfg $(LUA_LIB)
	@ls tests/test_*.nim | $(RUN_TESTS)

integration-test: nim.cfg $(LUA_LIB)
	@ls tests/integration_*.nim | $(RUN_TESTS)

# Minutes per test; several run >5 min. Run deliberately, not in a loop.
e2e-test: nim.cfg $(LUA_LIB)
	@ls tests/e2e_*.nim | $(RUN_TESTS)

test-all: test integration-test e2e-test

# Retired: generated/* bank modules deleted at M2.5.
test-banks: nim.cfg
	@echo "test-banks retired (no generated/* banks). Use: make test"
	@exit 0
# Autoresearch eval gate (docs/EVAL.md, docs/autoresearch-llm-play.md):
# segmented canary (fixtures + referee tests + scripted turbo walk) vs
# baseline.ref -> runs/<utc>-<idea>/scorecard.json. CONFIRM=1 = 5x walk
# budget, confirm-tier card (required before promote). IDEA names the run.
IDEA ?= candidate
eval: nim.cfg $(LUA_LIB)
	nim r $(NIM_TEST_FLAGS) src/tools/run_eval.nim --idea $(IDEA) $(if $(filter 1,$(CONFIRM)),--confirm,) "$(ROM)"

# Deliberate promote-time action: measure the scripted seed's actual canary
# numbers and pin them into baseline.ref. Never run inside a candidate eval.
eval-pin-baseline: nim.cfg $(LUA_LIB)
	nim r $(NIM_TEST_FLAGS) src/tools/run_eval.nim --pin-baseline "$(ROM)"

# Regenerate the static run-history report (hero series + per-run table)
# from runs/*/scorecard.json. Artifact is committed; numbers-only.
eval-report: nim.cfg
	nim r $(NIM_TEST_FLAGS) src/tools/eval_report.nim

# Art-wall mode: a windowed Agent run (qwen writes the Lua live) that
# restarts itself forever — leave it on a monitor and watch the bot work.
# Compiled once so restarts are instant; log appends to bin/llm_reports/.
llm-wall: nim.cfg
	@mkdir -p bin bin/states/llm bin/llm_reports
	nim c --hints:off --warnings:off --parallelBuild:4 -d:release -o:bin/llm_wall src/tools/llm_ai.nim
	@echo "llm-wall: windowed Agent loop (Ctrl+C in this terminal to stop)"
	while true; do \
	  bin/llm_wall --no-mock --pilot agent --tempo theater --watch-async \
	    --load-state-path bin/states/llm/bedroom.state \
	    --frames 100000000 "$(ROM)" >> bin/llm_reports/wall.log 2>&1; \
	  echo "llm-wall: run ended $$(date); restarting in 3s" | tee -a bin/llm_reports/wall.log; \
	  sleep 3; \
	done

# Headless speed + correctness referee (docs/raspberry-pi.md). `bench` times
# the fixed workload and compares hashes to the tape's .ref; `bench-check`
# replays every verified tape in full; `bench-ref` rewrites the goldens and is
# a deliberate act, like eval-pin-baseline. Goldens live beside their tapes in
# ../decompbound_secret (hashes only). NIMFLAGS adds e.g. "-d:danger --mm:arc".
BENCH_TAPE ?= ../decompbound_secret/sessions/20260816-223148
BENCH_FRAMES ?= 3600
BENCH_TAPES ?= ../decompbound_secret/sessions/20260816-223148 \
	../decompbound_secret/sessions/20260816-235052 \
	../decompbound_secret/sessions/20260817-000051 \
	../decompbound_secret/sessions/20260817-225201 \
	../decompbound_secret/sessions/20260817-230734
LABEL ?= local
NIMFLAGS ?=

bench: nim.cfg
	@mkdir -p bin/bench
	nim r $(NIM_TEST_FLAGS) -d:release $(NIMFLAGS) src/tools/bench_replay.nim "$(ROM)" "$(BENCH_TAPE)" --frames $(BENCH_FRAMES) --label "$(LABEL)" --out bin/bench/results.$$(hostname).tsv

bench-check: nim.cfg
	@nim c $(NIM_TEST_FLAGS) -d:release $(NIMFLAGS) -o:bin/bench_replay src/tools/bench_replay.nim
	@printf '%s\n' $(BENCH_TAPES) | xargs -P $(NIM_TEST_JOBS) -I{} sh -c \
	  'out=$$(bin/bench_replay "$(ROM)" "{}" 2>&1); rc=$$?; printf "%s\n" "$$out" | tail -4 | sed "s|^|[{}] |"; exit $$rc'

bench-ref: nim.cfg
	@nim c $(NIM_TEST_FLAGS) -d:release -o:bin/bench_replay src/tools/bench_replay.nim
	@for t in $(BENCH_TAPES); do bin/bench_replay "$(ROM)" "$$t" --write-ref | tail -2; done

# Shipping build of the player for a handheld / kiosk box (docs/raspberry-pi.md).
# Built on the target itself: the binary links against that box's libc, GL,
# X11, OpenAL, libevdev and libudev.
release-play: nim.cfg
	@mkdir -p bin
	nim c $(NIM_TEST_FLAGS) -d:release -d:fast -o:bin/decompbound-play src/tools/play.nim

# Fast compile-only gate (same idea as racha/satisfactory_tools/coworld):
# `nim check` entrypoints + unit tests without executing them.
check: nim.cfg
	@fail=0; \
	for f in src/decompbound.nim src/compare.nim \
	         src/tools/play.nim src/tools/llm_ai.nim src/tools/bench_replay.nim \
	         src/tools/chunk_check.nim src/tools/decompbound_mcp.nim; do \
		echo "==> nim check $$f"; \
		nim check $(NIM_TEST_FLAGS) "$$f" || fail=1; \
	done; \
	for f in tests/test_*.nim; do \
		echo "==> nim check $$f"; \
		nim check $(NIM_TEST_FLAGS) "$$f" || fail=1; \
	done; \
	if [ $$fail -eq 0 ]; then echo "==> make check OK"; fi; \
	exit $$fail

# Full-ROM typed chunks — per-chunk gold gate for sub-agents (docs/rom-chunks.md).
CHUNK ?= header
chunk-summary: nim.cfg
	nim r $(NIM_TEST_FLAGS) src/tools/chunk_check.nim summary

chunk-check: nim.cfg
	nim r $(NIM_TEST_FLAGS) src/tools/chunk_check.nim check $(CHUNK)

chunk-check-all: nim.cfg
	nim r $(NIM_TEST_FLAGS) src/tools/chunk_check.nim check-all-implemented

clean:
	rm -f bin/Decompbound.smc bin/screenshot.png bin/intro.png bin/title.png bin/song.wav bin/frame_*.png
