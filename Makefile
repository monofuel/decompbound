.PHONY: help build compare test integration-test e2e-test test-all test-banks check clean regions boot screenshot intro title song vectors spc-vectors disasm play play-tas play-cont play-pokey archive archive-replays play-verbose gamepad-test sram serve frames lua-test llm-play llm-ai llm-ai-prologue llm-ai-scripted llm-ai-scripted-campaign llm-ai-display llm-ai-display-loop mcp testrom script-dump gfx-roundtrip battle-bg trace inspect audio-check jukebox-app chunk-summary chunk-check chunk-check-all eval eval-pin-baseline run-report bench bench-check bench-ref release-play

# bash + pipefail: the test loop pipes nim through sed, and without
# pipefail the pipeline's exit status is sed's (always 0), which turns
# every test failure into a false green.
SHELL := bash
.SHELLFLAGS := -o pipefail -c

ROM ?= bin/Earthbound (U) [!].smc
BG ?= 0
FRAMES ?= 60
# parallelBuild: without it each nim invocation fans out gcc to ALL cores, so
# NIM_TEST_JOBS x nproc cc1 processes (4 x 32 = 128) swamp the box — the job
# cap only bounds the nim drivers, not the C backend.
NIM_TEST_FLAGS ?= --hints:off --warnings:off --parallelBuild:4
LUA_LIB := vendor/lua/liblua.a

help:
	@echo "decompbound targets:"
	@echo "  make compare      - phase-2 extract/rebuild vs gold (BYTE-IDENTICAL gate)"
	@echo "  make check        - nim check main entrypoints + tests (no run)"
	@echo "  make test         - unit tests only, no fixtures needed (instant)"
	@echo "  make integration-test - needs the gold ROM / CPU vectors (seconds)"
	@echo "  make e2e-test     - boots the emulator + save-states (minutes)"
	@echo "  make test-all     - all three tiers"
	@echo "  make bench        - time the fixed replay workload + ref compare (BENCH_TAPE, BENCH_FRAMES, NIMFLAGS, LABEL)"
	@echo "  make bench-check  - replay all verified tapes in full against their .ref goldens"
	@echo "  make bench-ref    - (re)write the .ref goldens from this build (deliberate)"
	@echo "  make release-play - shipping build of the player (bin/decompbound-play, -d:fast)"
	@echo "  make eval         - llm-play autoresearch gate: canary + scorecard (IDEA=name CONFIRM=1; docs/EVAL.md)"
	@echo "  make chunk-summary - full-ROM typed chunk inventory (see docs/rom-chunks.md)"
	@echo "  make chunk-check CHUNK=id - gold-check one chunk (sub-agent gate)"
	@echo "  make chunk-check-all - gold-check every implemented chunk"
	@echo "  make boot         - trace the real ROM booting on the emulator"
	@echo "  make screenshot   - render the boot state to bin/screenshot.png"
	@echo "  make play         - windowed interactive player (arrows/ZXAS/Enter/RShift/Space/N/F12/+/ - /Esc)"
	@echo "  make play-tas       - replay chain from first segment through latest"
	@echo "  make play-cont     - continue from the newest F12 / end screenstate"
	@echo "  make llm-ai-prologue - gold TAS to sunrise, then the LLM/bot takes over"
	@echo "  make run-report SESSION=... - TAS/F12 diagnostic report → bin/reports/ (gitignored)"
	@echo "  make mcp          - Goal 5 playthrough co-pilot MCP (http://localhost:4343/mcp)"
	@echo "  make intro        - screenshot the 'War Against Giygas' title card"
	@echo "  make title        - screenshot deep into the attract sequence"
	@echo "  make frames       - render reference frames to bin/frame_<N>.png"
	@echo "  make jukebox SONG=N - render EarthBound song N to bin/jukebox_songNNN.wav (7/8 songs play)"
	@echo "  make jukebox-app  - interactive GUI jukebox (click songs in list; realtime slappy audio)"
	@echo "  make vectors      - full 65816 CPU vector sweep (needs bin/65816-vectors)"
	@echo "  make spc-vectors  - full SPC700 vector sweep (needs bin/spc700-vectors)"
	@echo "  make regions      - regenerate all code regions from the gold ROM"
	@echo "  make disasm OFF=0x8000 N=40 - disassemble at a file offset"
	@echo "  make lua-test     - build and run the Lua 5.3 embed smoke test (milestone 1)"

# nim.cfg is generated by nimby from the lock file; run `make nim.cfg`
# after changing nimby.lock.
nim.cfg: nimby.lock
	nimby sync -g nimby.lock

# Static Lua 5.3 for the policy embed (gitignored archive; rebuild from the
# vendor/lua submodule). Required by anything that links policy / lua53.
$(LUA_LIB):
	@if [ ! -f vendor/lua/makefile ] && [ ! -f vendor/lua/Makefile ]; then \
	  echo "vendor/lua missing — run: git submodule update --init vendor/lua"; \
	  exit 1; \
	fi
	$(MAKE) -C vendor/lua a

build: nim.cfg
	nim r src/tools/rom_extract.nim
	nim r src/tools/rom_rebuild.nim --out bin/Decompbound.smc --no-compare
	nim r src/decompbound.nim

compare: nim.cfg
	nim r src/tools/rom_extract.nim
	nim r src/tools/rom_rebuild.nim

# --- Emulator ---------------------------------------------------------

boot: nim.cfg
	nim r -d:release src/tools/boot_trace.nim "$(ROM)" 2000000 25

screenshot: nim.cfg
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/screenshot.png 2500000
	@echo "wrote bin/screenshot.png (APE logo era)"

intro: nim.cfg
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/intro.png 16000000 noinput
	@echo "wrote bin/intro.png (the War Against Giygas title card)"

title: nim.cfg
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/title.png 64000000
	@echo "wrote bin/title.png (deep attract / file select era)"

frames: nim.cfg
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/frame_3629.png frame:3629 noinput
	@echo "wrote bin/frame_3629.png (EarthBound logo assembled, pre-gradient)"
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/frame_4200.png frame:4200 noinput
	@echo "wrote bin/frame_4200.png (logo with glow)"
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/frame_8000.png frame:8000 noinput
	@echo "wrote bin/frame_8000.png (attract-mode world exploration with credits)"
	nim r -d:release src/tools/screenshot.nim "$(ROM)" bin/frame_10000.png frame:10000 noinput
	@echo "wrote bin/frame_10000.png (attract-mode world exploration with credits)"

play: nim.cfg
	@mkdir -p bin
	@printf '%s  commit %s%s  ROM=%s\n' "$$(date '+%Y-%m-%d %H:%M:%S')" "$$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" "$$(git diff --quiet HEAD 2>/dev/null || echo ' +dirty')" "$(ROM)" | tee -a bin/play_sessions.log
	nim r -d:release src/tools/play.nim "$(ROM)"
	@echo "player exited"

# Windowed TAS: no TAS= → newest cadence-emu movie. Sequels chain automatically.
play-tas: nim.cfg
	@mkdir -p bin
	@if [ -n "$(TAS)" ] && [ -n "$(STATE)" ]; then \
	  nim r -d:release src/tools/play.nim --tas "$(TAS)" --load-state-path "$(STATE)" "$(ROM)"; \
	elif [ -n "$(TAS)" ]; then \
	  nim r -d:release src/tools/play.nim --tas "$(TAS)" "$(ROM)"; \
	else \
	  nim r -d:release src/tools/play.nim --tas-latest "$(ROM)"; \
	fi
	@echo "player exited"

# Continue the last human seat: newest earthbound_*.png F12 (session or Pictures).
play-cont: nim.cfg
	@mkdir -p bin
	@printf '%s  commit %s%s  ROM=%s --continue\n' "$$(date '+%Y-%m-%d %H:%M:%S')" "$$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" "$$(git diff --quiet HEAD 2>/dev/null || echo ' +dirty')" "$(ROM)" | tee -a bin/play_sessions.log
	nim r -d:release src/tools/play.nim --continue "$(ROM)"
	@echo "player exited"

# Archive capture sessions (replay pairs + F12 bookmarks) to the private
# secret repo. play.nim auto-archives on clean exit; this sweeps everything
# (crashed sessions, legacy bin/replays). Game-derived states never go in
# THIS repo; pairs stay together in ../decompbound_secret.
archive:
	@mkdir -p ../decompbound_secret/sessions ../decompbound_secret/screenstates
	@if [ -d bin/sessions ]; then \
	  for d in bin/sessions/*/; do \
	    [ -d "$$d" ] || continue; \
	    dest=../decompbound_secret/sessions/$$(basename $$d); mkdir -p $$dest; \
	    cp -n $$d*.tas $$d*.state $$d*.ref $$dest/ 2>/dev/null || true; \
	    cp -n $$d/f12/*.png ../decompbound_secret/screenstates/ 2>/dev/null || true; \
	  done; fi
	@if [ -d bin/replays ]; then mkdir -p ../decompbound_secret/replays && cp -n bin/replays/* ../decompbound_secret/replays/ 2>/dev/null || true; fi
	@echo "archived: replay pairs -> secret/sessions/, screenstates -> secret/screenstates/"

archive-replays: archive

# Pokey breadcrumb run: start at Ness's front door on the meteor night (llm
# fixture, NOT your personal slots). Input recording is on by default — just
# walk to Pokey, talk to him, and close the window; the .tas lands in bin/replays/.
play-pokey: nim.cfg
	@mkdir -p bin
	nim r -d:release src/tools/play.nim --load-state-path bin/states/llm/onett_start.state "$(ROM)"
	@echo "player exited"

# Headless TAS report (dialogue / story / levels). SESSION= or TAS=+STATE=.
# Writes bin/reports/ only — extracted game text, never commit.
# Docs: docs/run-report.md
run-report: nim.cfg
	@mkdir -p bin/reports
	@if [ -n "$(SESSION)" ]; then \
	  nim r -d:release src/tools/run_report.nim --session "$(SESSION)" $(ARGS); \
	elif [ -n "$(TAS)" ] && [ -n "$(STATE)" ]; then \
	  nim r -d:release src/tools/run_report.nim "$(ROM)" "$(STATE)" "$(TAS)" $(ARGS); \
	elif [ -n "$(F12)" ]; then \
	  nim r -d:release src/tools/run_report.nim --f12 "$(F12)" $(ARGS); \
	elif [ "$(LATEST)" = "1" ]; then \
	  nim r -d:release src/tools/run_report.nim --latest-f12 $(ARGS); \
	else \
	  echo "usage: make run-report SESSION=../decompbound_secret/sessions/<ts>"; \
	  echo "       make run-report TAS=path.tas STATE=path.state"; \
	  echo "       make run-report LATEST=1   # current screenstate"; \
	  echo "       make run-report F12=path.png"; \
	  exit 2; \
	fi

# Same as play, but prints which paddy gamepad buttons/axes fire — use this to
# report how a specific controller maps its face buttons + d-pad.
play-verbose: nim.cfg
	nim r -d:release src/tools/play.nim --verbose "$(ROM)"
	@echo "player exited"

# Standalone USB controller tester: shows how a pad reports its buttons/d-pad
# and which SNES button each maps to. No window/ROM needed. Ctrl+C to quit.
gamepad-test: nim.cfg
	nim r -d:release src/tools/gamepad_test.nim

# Inspect the EarthBound battery save (SRAM). `make sram` dumps mapped fields;
# `make sram ARGS="--find 20"` locates a value so we can map more of the format.
sram: nim.cfg
	nim r -d:release src/tools/sram_info.nim $(ARGS)

# Goal 5 playthrough co-pilot: MCPort HTTP MCP (party HP/PP from .srm).
# Docs: docs/mcp-server.md. Port 4343 avoids FFXIV MCP on 4242.
mcp: nim.cfg
	nim r -d:release src/tools/decompbound_mcp.nim

# Serve docs/ locally (HTML docs + diagrams) via Mummy. Open http://localhost:8080/
# Override the port with: make serve PORT=9000
PORT ?= 8080
serve: nim.cfg
	nim r -d:release src/tools/serve.nim $(PORT)

# Jukebox: render an EarthBound song to a WAV via the standalone SPC player.
